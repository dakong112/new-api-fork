# KID API 生产环境配置 —— 复制为 .env 后填写
#
#   cp .env.prod.example .env
#
# .env 已在 .gitignore 中，不会被提交。搭配 docker-compose.prod.yml 使用。

# ── 必填 ────────────────────────────────────────────────────────────────

# 你已部署的 PostgreSQL。前缀必须是 postgresql:// 或 postgres://，
# 否则会被当成 MySQL DSN 处理（见 model/main.go:151）。
# 密码含特殊字符必须 URL 编码：@ → %40，# → %23，/ → %2F，: → %3A
#
# 注意主机名：容器内的 localhost 指向容器自己，不是宿主机。
#   - PG 在另一台机器：直接写它的地址
#   - PG 在本机（宿主机）：用 host.docker.internal（compose 里已配好
#     extra_hosts 映射），或直接写宿主机内网 IP
SQL_DSN=postgresql://admin:123456@host.docker.internal:50088/new-api

# 你已部署的 Redis。格式由 go-redis 的 ParseURL 解析：
#   redis://[user]:[password]@host:port/db     普通连接
#   rediss://[user]:[password]@host:port/db    TLS 连接
# 无密码时写 redis://host:6379。
#
# 注意 common/redis.go:44 在 ping 失败时调的是 FatalLog —— Redis 连不上
# 进程会直接退出，容器进入 crash-loop。部署前先确认网络可达。
#
# 主机名同样注意：容器内 localhost 指向容器自己。Redis 在宿主机上就用
# host.docker.internal（compose 里已配好 extra_hosts）或宿主机内网 IP。
REDIS_CONN_STRING=redis://:admin@888@host.docker.internal:6379

# Redis 连接池大小，默认 10。
# REDIS_POOL_SIZE=10

# 会话签名密钥。不设置的话每次重启所有用户被登出。
# 生成：openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# ── HTTPS 部署（有域名时必填）────────────────────────────────────────────

# true 时启用 Secure Cookie 与严格的 refresh/logout OriginGuard。
# 纯本地 HTTP 调试才留空或设 false。
SESSION_COOKIE_SECURE=true

# SESSION_COOKIE_SECURE=true 时必填。精确的 HTTPS Origin，逗号分隔。
# 不支持通配符和路径。这不是 relay 的 CORS 白名单。
SESSION_COOKIE_TRUSTED_URL=https://kid.dakongsoftware.cn

# 反向代理所在网段。留空则信任回环/RFC1918/fc00::/7 并打告警；
# 填 none 为严格模式（谁都不信）。填错会导致取到错误的客户端 IP，
# 进而影响限流和审计日志。
TRUSTED_PROXIES=172.16.0.0/12

# ── 可选 ────────────────────────────────────────────────────────────────

TZ=Asia/Shanghai
NODE_NAME=kid-api-node-1

# 外部 PostgreSQL 的连接池上限。PG 默认 max_connections=100，
# 多个应用共用同一实例时按需再调小。
SQL_MAX_OPEN_CONNS=50
SQL_MAX_IDLE_CONNS=10

# 日志表分库。不填则与主库共用（logs 表通常是最大的一张）。
# LOG_SQL_DSN=postgresql://newapi:CHANGE_ME@10.0.0.2:5432/new-api-log

# 多实例部署时，除主节点外全部要设为 slave。
# 只有主节点执行数据库迁移（见 common/init.go:89），
# 多个节点同时 AutoMigrate 会互相打架。
# NODE_TYPE=slave

# 流式响应无响应超时（秒），默认 120。出现空补全可调大。
# STREAMING_TIMEOUT=300
